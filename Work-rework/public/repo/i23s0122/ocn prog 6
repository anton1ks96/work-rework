</head>
 
<body>
    <H1>Здраствуй! Введите число для создании таблицы.</H1>
    <input id="num" type="number">
    <button onclick="work()">ОК</button>
    <p id="errorResult"></p>
    <table id="table"></table>
</body>
<script>
    function work() {
        tab = document.getElementById("table");
        num = parseFloat(document.getElementById('num').value);
        if (num === parseInt(num) && num > 0 && num < 10) {
            tab.innerHTML = '';
            errorResult.innerText = '';
            for (let i = 0; i < num; i++) {
                tr = document.createElement('tr');
                for (let j = 0; j < num; j++) {
                    let td = document.createElement('td');
                    id = i * 10 + j;
                    td.setAttribute('id', id);
                    td.setAttribute("onclick", "tdclick(" + id + ")");
                    td.setAttribute("style", "background-color: white");
 
                    td.innerText = i + ":" + j;
                    tr.appendChild(td);
                }
                tab.appendChild(tr);
            }
 
 
        }
        else {
            tab.innerHTML = "";
            errorResult.innerText = "Слишком большое число";
        }
 
    }
 
</script>
 
</html>
