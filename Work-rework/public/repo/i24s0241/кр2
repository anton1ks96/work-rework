<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Вёрстка сайта</title>
    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
        }
        .header {
            background-color: yellow;
            padding: 20px;
            text-align: center;
        }
        .container {
            padding: 20px;
        }
        .section {
            background-color: lightgray;
            padding: 15px;
            margin: 10px 0;
        }
        .blue-box {
            background-color: lightblue;
            padding: 10px;
            margin: 5px 0;
        }
        .green-bar {
            background-color: lightgreen;
            height: 10px;
            margin: 10px 0;
        }
        .footer {
            background-color: red;
            color: white;
            text-align: center;
            padding: 10px;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>Заголовок сайта</h1>
    </div>
    <div class="container">
        <div class="section">
            <div class="blue-box">Блок 1 (синий)</div>
            <div class="green-bar"></div>
            <div class="blue-box">Блок 2 (синий)</div>
        </div>
        <div class="section">
            <div class="blue-box">Блок 3 (синий)</div>
            <div class="green-bar"></div>
            <div class="blue-box">Блок 4 (синий)</div>
        </div>
        <div class="section">
            <div class="blue-box">Блок 5 (синий)</div>
            <div class="green-bar"></div>
            <div class="blue-box">Блок 6 (синий)</div>
        </div>
    </div>
    <div class="footer">
        <p>Нижний колонтитул</p>
    </div>
</body>
</html>
