* styles.css */
body {
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 0;
}

.header {
    background-color: yellow;
    padding: 20px;
    text-align: center;
}

.text-block {
    background-color: lightgray;
    padding: 20px;
    margin: 10px;
}

.green-header {
    background-color: green;
    color: white;
    padding: 10px;
    margin: 10px;
}

.text-image-block {
    display: flex;
    align-items: center;
    margin: 10px;
}

.image-block {
    background-color: lightblue; 
    padding: 10px;
    margin-right: 20px;
}

.image-block img {
    width: 100px; 
    height: auto;
}

.footer {
    background-color: red;
    color: white;
    text-align: center;
    padding: 10px;
}